{
 "study": {
  "description": {
   "extraction_status": "extracted",
   "value": "A multimodal neuroimaging study examining associations between gray matter volume measured with voxel-based morphometry and cerebral perfusion measured with arterial spin labeling in heroin-dependent patients under heroin and placebo conditions.",
   "value_source": "reported",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "quotes": [
       "Using a double-blind, within-subject design, heroin or placebo (saline) was administered to 14 heroin-dependent patients from a stable heroin-assisted treatment program, in order to observe acute short-term effects. Arterial spin labeling (ASL) was used to calculate perfusion quantification maps in both treatment conditions, while Voxel-Based Morphometry (VBM) was conducted to calculate regional GM density."
      ]
     }
    ]
   }
  },
  "design": {
   "description": {
    "extraction_status": "extracted",
    "value": "Double-blind, randomized crossover, within-subject study in which 14 heroin-dependent outpatients received intravenous heroin or placebo on separate scanning occasions approximately 8.4 days apart.",
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "In a cross-over, double-blind design, placebo (5 ml saline), and half of the daily heroin dose (mean = 176 ± 89.1 mg) were administered intravenously over a period of 30 s by a study nurse 20 min before the scanning session started."
       ]
      }
     ]
    }
   },
